<Project>
    <PropertyGroup>
        <CaeriusDistributionPackage Condition="'$(MSBuildProjectName)' == 'CaeriusNet' or '$(MSBuildProjectName)' == 'CaeriusNet.Redis' or '$(MSBuildProjectName)' == 'CaeriusNet.Aspire' or '$(MSBuildProjectName)' == 'CaeriusNet.Contracts'">true</CaeriusDistributionPackage>
        <IsPackable Condition="'$(CaeriusDistributionPackage)' != 'true'">false</IsPackable>
        <TargetFramework Condition="'$(TargetFramework)' == '' and '$(IsRoslynComponent)' != 'true'">net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnableTrimAnalyzer Condition="'$(CaeriusDistributionPackage)' == 'true'">true</EnableTrimAnalyzer>
        <EnableAotAnalyzer Condition="'$(CaeriusDistributionPackage)' == 'true'">true</EnableAotAnalyzer>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors Condition="'$(CaeriusDistributionPackage)' == 'true'">true</CodeAnalysisTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors Condition="'$(CaeriusDistributionPackage)' != 'true'">false</CodeAnalysisTreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <NoWarn Condition="'$(CaeriusDistributionPackage)' == 'true'">$(NoWarn);RS0050;RS0051;RS0052;RS0053;RS0054;RS0055;RS0056;RS0057;RS0058;RS0059;RS0060;RS0061</NoWarn>

        <Version>11.2.0</Version>
        <Authors>AriusII &amp; CaeriusNet</Authors>
        <Company>CaeriusNet</Company>
        <Copyright>Copyright © CaeriusNet 2026</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://caerius.net</PackageProjectUrl>
        <RepositoryUrl>https://github.com/CaeriusNET/CaeriusNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>https://github.com/CaeriusNET/CaeriusNet/releases/tag/v$(Version)</PackageReleaseNotes>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile Condition="'$(CaeriusDistributionPackage)' == 'true'">true</GenerateDocumentationFile>
        <EnablePackageValidation Condition="'$(CaeriusDistributionPackage)' == 'true'">true</EnablePackageValidation>
        <PackageValidationBaselineVersion Condition="'$(CaeriusDistributionPackage)' == 'true' and '$(Version)' != '11.2.0'">11.2.0</PackageValidationBaselineVersion>
        <NuGetAuditLevel>moderate</NuGetAuditLevel>
        <NuGetAuditMode>all</NuGetAuditMode>
        <!-- The committed lock graph makes every CI restore reproducible. Local restore
             updates it deliberately; CI also passes the locked-mode switch explicitly. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup Condition="'$(CaeriusDistributionPackage)' == 'true'">
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false"/>
        <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="" Visible="false"/>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' != 'CaeriusNet' and '$(MSBuildProjectName)' != 'CaeriusNet.Aspire'">
        <AssemblyAttribute Include="System.CLSCompliantAttribute">
            <_Parameter1>false</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
