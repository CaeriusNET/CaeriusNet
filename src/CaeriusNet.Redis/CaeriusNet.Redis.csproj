<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>CaeriusNet.Redis</AssemblyName>
        <PackageId>CaeriusNet.Redis</PackageId>
        <RootNamespace>CaeriusNet.Redis</RootNamespace>
        <IsPackable>true</IsPackable>
        <Title>CaeriusNet.Redis</Title>
        <Description>Async Redis cache integration for CaeriusNet with typed AOT-safe codecs and a versioned binary envelope.</Description>
        <PackageTags>caeriusnet;redis;stackexchange.redis;cache;binary-codec;sql-server;net10</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\CaeriusNet\CaeriusNet.csproj"/>
        <PackageReference Include="StackExchange.Redis"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
