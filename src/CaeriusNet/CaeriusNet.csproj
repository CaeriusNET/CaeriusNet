<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>CaeriusNet</AssemblyName>
        <PackageId>CaeriusNet</PackageId>
        <RootNamespace>CaeriusNet</RootNamespace>
        <IsPackable>true</IsPackable>
        <Title>CaeriusNet</Title>
        <Description>Stored-procedure-only SQL Server runtime for .NET 10 with compile-time DTO and TVP mapping, deterministic caching, transactions, and BCL telemetry.</Description>
        <PackageTags>sql-server;stored-procedures;micro-orm;source-generator;tvp;dto;caching;transactions;opentelemetry;net10</PackageTags>
        <!-- Arity-specific multi-result APIs intentionally share names and optional capacity/policy parameters. -->
        <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient"/>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Compiler\CaeriusNet.Generator\CaeriusNet.Generator.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all"/>
        <ProjectReference Include="..\Compiler\CaeriusNet.Analyzer\CaeriusNet.Analyzer.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all"/>
        <ProjectReference Include="..\Compiler\CaeriusNet.MultiResultApiGenerator\CaeriusNet.MultiResultApiGenerator.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Compiler\CaeriusNet.Generator\bin\$(Configuration)\netstandard2.0\CaeriusNet.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false"/>
        <None Include="..\Compiler\CaeriusNet.Generator\bin\$(Configuration)\netstandard2.0\CaeriusNet.Generator.pdb"
              Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false"/>
        <None Include="..\Compiler\CaeriusNet.Analyzer\bin\$(Configuration)\netstandard2.0\CaeriusNet.Analyzer.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false"/>
        <None Include="..\Compiler\CaeriusNet.Analyzer\bin\$(Configuration)\netstandard2.0\CaeriusNet.Analyzer.pdb"
              Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false"/>
    </ItemGroup>
</Project>
