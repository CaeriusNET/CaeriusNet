<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>CaeriusNet.Generator.Tests</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningLevel>4</WarningLevel>
        <AnalysisLevel>latest</AnalysisLevel>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Roslyn APIs for running generators in-process -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Reference generator as a plain DLL (not as Analyzer) so we can instantiate generators in tests -->
        <ProjectReference Include="..\..\src\Compiler\CaeriusNet.Generator\CaeriusNet.Generator.csproj"/>
        <ProjectReference Include="..\..\src\Compiler\CaeriusNet.MultiResultApiGenerator\CaeriusNet.MultiResultApiGenerator.csproj"/>
        <!-- Reference main library for ISpMapper, ITvpMapper, attributes -->
        <ProjectReference Include="..\..\src\CaeriusNet\CaeriusNet.csproj"/>
    </ItemGroup>

</Project>
