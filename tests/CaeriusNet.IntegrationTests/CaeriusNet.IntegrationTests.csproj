<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>CaeriusNet.IntegrationTests</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningLevel>4</WarningLevel>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
        <!-- Release validates this project once against the exact packed dependencies.  The default
             remains source references so developers and normal CI retain the fast inner loop. -->
        <UseCaeriusReleasePackages Condition="'$(UseCaeriusReleasePackages)' == ''">false</UseCaeriusReleasePackages>
        <CaeriusPackageVersion Condition="'$(CaeriusPackageVersion)' == ''">$(Version)</CaeriusPackageVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(UseCaeriusReleasePackages)' == 'true'">
        <!-- A package gate redirects obj/bin to a temporary directory.  Keep any regular local
             obj/bin artifacts out of the default Compile globs while that redirection is active. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Data.SqlClient"/>
        <PackageReference Include="Testcontainers.MsSql"/>
        <PackageReference Include="Testcontainers.Redis"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UseCaeriusReleasePackages)' == 'true'">
        <PackageVersion Include="CaeriusNet" Version="$(CaeriusPackageVersion)"/>
        <PackageVersion Include="CaeriusNet.Redis" Version="$(CaeriusPackageVersion)"/>
        <PackageVersion Include="CaeriusNet.Aspire" Version="$(CaeriusPackageVersion)"/>
        <PackageReference Include="CaeriusNet"/>
        <PackageReference Include="CaeriusNet.Redis"/>
        <PackageReference Include="CaeriusNet.Aspire"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UseCaeriusReleasePackages)' != 'true'">
        <ProjectReference Include="..\..\src\CaeriusNet\CaeriusNet.csproj"/>
        <ProjectReference Include="..\..\src\CaeriusNet.Redis\CaeriusNet.Redis.csproj"/>
        <ProjectReference Include="..\..\src\CaeriusNet.Aspire\CaeriusNet.Aspire.csproj"/>
        <ProjectReference Include="..\..\src\Compiler\CaeriusNet.Generator\CaeriusNet.Generator.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all"/>
        <ProjectReference Include="..\..\src\Compiler\CaeriusNet.Analyzer\CaeriusNet.Analyzer.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all"/>
    </ItemGroup>

</Project>
